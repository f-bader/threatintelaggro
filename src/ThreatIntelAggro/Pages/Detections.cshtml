@page
@model DetectionsModel
@{
    ViewData["Title"] = "Detection Ideas";
    var fragment = ViewContext.HttpContext.Request.Headers["X-Review-Fragment"].ToString() == "detections";
    ViewContext.HttpContext.Response.Headers.Vary = "X-Review-Fragment";
    if (fragment) Layout = null;
}
@if (!fragment) {
<div class="page-heading"><div><div class="eyebrow">DETECTION ENGINEERING / QUEUE</div><h1>Detection Ideas</h1><p class="subhead">AI drafted, evidence linked, and ready for analyst review.</p></div><a class="button button-secondary" asp-page="/Inbox">← &nbsp;Back to inbox</a></div>
@if (Model.ArticleId is > 0) { <div class="article-filter-note">Showing detections linked to <strong>@Model.FilterArticleTitle</strong> <a asp-page="/Detections" asp-route-state="@Model.State">CLEAR ARTICLE FILTER</a></div> }
}
<section class="panel" data-review-panel="detections" data-review-count="@(fragment ? Model.ActiveCount : 0)">
 <div class="panel-head"><div><div class="eyebrow">DRAFTS / REVIEW TRACKING</div><h2>Detection queue <span class="count-chip">@Model.Items.Count</span></h2></div><form method="get" class="toolbar"><input type="hidden" name="articleId" value="@Model.ArticleId"/><select name="state" aria-label="Detection archive state" data-auto-submit><option value="active" selected="@(Model.State != "archived")">Active drafts</option><option value="archived" selected="@(Model.State == "archived")">Archived</option></select></form></div>
 @if (!string.IsNullOrWhiteSpace(Model.StatusMessage)) { <div class="detection-family-message" role="status">@Model.StatusMessage</div> }
 @if (Model.Items.Count == 0) { <div class="empty-state"><div class="empty-icon">⌁</div><h3>No detection drafts yet</h3><p>Run article analysis from the inbox. Supported behaviors will appear here; the model can also record an explicit no-detection outcome.</p><a class="button button-secondary" asp-page="/Inbox">Open article inbox</a></div> }
 <div class="detection-list">
 @foreach (var item in Model.Items) {
  <article class="detection-card" id="detection-@item["id"]"><div class="detection-header"><div><div class="article-meta"><span class="status-pill status-on">@item["severity"]</span><span class="status-pill" data-detection-status>@item["status"]</span><span>Validation: @item["validation_state"]</span>@if (!string.IsNullOrEmpty(item["family_id"])) { <span class="detection-iteration-pill">ITERATION @item["iteration_number"]</span> }</div><h3>@item["alert_title"]</h3><p class="article-summary">@item["description"]</p></div><span class="section-index" aria-hidden="true"></span></div>
  @if (!string.IsNullOrEmpty(item["family_id"]) && Model.Families.TryGetValue(item["family_id"]!, out var familyMembers)) {
   <div class="detection-family"><div><strong>ITERATION GROUP</strong><span>Related drafts kept separately for comparison</span></div><ol>@foreach (var member in familyMembers) { <li class="@(member.Id == item["id"] ? "current" : "")"><a href="#detection-@member.Id">ITERATION @member.Iteration · @member.Title</a><small>@member.ArticleTitle</small></li> }</ol>
    @if (Model.State != "archived") { <form method="post" asp-page-handler="Ungroup"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="returnState" value="active"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><button class="small-action" type="submit">REMOVE FROM GROUP</button></form> }
   </div>
  }
  <p><strong>From article:</strong> <a href="@item["article_url"]" target="_blank" rel="noopener">@item["article_title"] ↗</a></p><p>@item["rationale"]</p>
  @if (Model.State != "archived" && string.IsNullOrEmpty(item["family_id"]) && long.TryParse(item["id"], out var detectionId) && Model.Overlaps.TryGetValue(detectionId, out var overlaps) && overlaps.Count > 0) {
   <div class="detection-overlaps"><div><strong>POSSIBLE OVERLAP</strong><span>Review these matches. Grouping keeps every draft and source article.</span></div><ul>@foreach (var overlap in overlaps) { <li><div><a href="#detection-@overlap.DetectionId">@overlap.Title</a><small>@overlap.Reason · @overlap.Score% text overlap</small></div><form method="post" asp-page-handler="GroupAsIterations"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="relatedId" value="@overlap.DetectionId"/><input type="hidden" name="returnState" value="active"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><button class="small-action" type="submit">GROUP AS ITERATIONS</button></form></li> }</ul></div>
  }
  <details class="query-details evidence-details"><summary>BEHAVIOR EVIDENCE</summary>
   @{ var behaviors = DetectionsModel.Behaviors(item["behaviors_json"]); }
   @if (behaviors.Count == 0) { <p>No structured behavior evidence was recorded for this draft. Review the source before using it.</p> }
   @foreach (var behavior in behaviors) { if (behavior is System.Text.Json.Nodes.JsonObject obj) { <div class="evidence-item"><p><strong>@obj["description"]</strong> <span>· @obj["basis"] · @obj["confidence"] confidence</span></p>@if (obj["evidence"] is System.Text.Json.Nodes.JsonArray evidence) { @foreach (var entry in evidence) { if (entry is System.Text.Json.Nodes.JsonObject citation) { <blockquote>@citation["excerpt"]</blockquote><small>Source @citation["source_id"] · @citation["locator"]</small> } } }</div> } }
  </details>
  <details class="query-details"><summary>SHOW KQL QUERY</summary><pre><code>@item["kql"]</code></pre></details>
  @using (var playbookDoc = System.Text.Json.JsonDocument.Parse(item["playbook_json"] ?? "{}")) { var playbook = playbookDoc.RootElement;
  <details class="query-details playbook-details"><summary>PLAYBOOK IDEA</summary><div class="playbook-view"><h4>@(playbook.TryGetProperty("title", out var playTitle) ? playTitle.GetString() : "Response playbook")</h4><div class="playbook-grid">
   @foreach (var group in new[] { ("TRIAGE", "triage_steps"), ("INVESTIGATION", "investigation_steps"), ("RESPONSE OPTIONS", "response_options") }) { if (playbook.TryGetProperty(group.Item2, out var steps) && steps.ValueKind == System.Text.Json.JsonValueKind.Array && steps.GetArrayLength() > 0) { <div class="playbook-section"><h5>@group.Item1</h5><ol>@foreach (var step in steps.EnumerateArray()) { <li>@step.GetString()</li> }</ol></div> } }
  </div></div></details> }
  @using (var telemetryDoc = System.Text.Json.JsonDocument.Parse(item["telemetry_json"] ?? "{}")) { var telemetry = telemetryDoc.RootElement;
  <details class="query-details telemetry-details"><summary>TELEMETRY REQUIREMENTS</summary><div class="telemetry-view">
   @foreach (var group in new[] { ("TABLES", "tables"), ("REQUIRED COLUMNS", "required_columns"), ("ASSUMPTIONS", "assumptions"), ("KNOWN GAPS", "known_gaps") }) { if (telemetry.TryGetProperty(group.Item2, out var values) && values.ValueKind == System.Text.Json.JsonValueKind.Array && values.GetArrayLength() > 0) { <div><h5>@group.Item1</h5><ul>@foreach (var value in values.EnumerateArray()) { <li>@value.GetString()</li> }</ul></div> } }
  </div></details> }
  <div class="detection-actions"><a class="small-action" asp-page-handler="Yaml" asp-route-id="@item["id"]">DOWNLOAD XDRCONVERTER YAML</a><a class="small-action" asp-page-handler="Kql" asp-route-id="@item["id"]">DOWNLOAD KQL</a><a class="small-action" asp-page-handler="Json" asp-route-id="@item["id"]">EXPORT JSON</a>
   @if (Model.State == "archived") { <form method="post" data-review-action asp-page-handler="Unarchive"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="returnState" value="archived"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><button class="small-action" type="submit">RESTORE</button></form> }
   else { <form method="post" data-review-action data-inline-status asp-page-handler="Update" class="inline-form"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="returnState" value="active"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><select name="status" aria-label="Review status"><option value="new" selected="@(item["status"] == "new")">New</option><option value="reviewing" selected="@(item["status"] == "reviewing")">Reviewing</option><option value="accepted" selected="@(item["status"] == "accepted")">Accepted</option><option value="rejected" selected="@(item["status"] == "rejected")">Rejected</option><option value="implemented" selected="@(item["status"] == "implemented")">Implemented</option></select><button class="small-action" type="submit">SAVE STATUS</button></form><form method="post" data-review-action asp-page-handler="Archive"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="returnState" value="active"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><button class="small-action" type="submit">ARCHIVE</button></form> }
   <form method="post" asp-page-handler="Delete" data-confirm="Permanently delete this detection idea?"><input type="hidden" name="id" value="@item["id"]"/><input type="hidden" name="state" value="@Model.State"/><input type="hidden" name="articleId" value="@Model.ArticleId"/><button class="small-action danger-action" type="submit">DELETE</button></form>
  </div></article>
 }
 </div>
</section>
