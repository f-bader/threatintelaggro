@page
@model IocsModel
@{
    ViewData["Title"] = "IOCs";
}
<div class="page-heading"><div><div class="eyebrow">OBSERVABLES / INTELLIGENCE INDEX</div><h1>Indicator library</h1><p class="subhead">Article sourced indicators with affected vendors, targeted industries, and provenance.</p></div><a class="button button-secondary" asp-page="/Index">← &nbsp;Back to inbox</a></div>
<section class="panel">
 <div class="panel-head"><div><div class="eyebrow">PUBLISHED IN THE LAST @Model.Days DAYS</div><h2>@(Model.State == "archived" ? "Archived indicators" : "Indicators") <span class="count-chip">@Model.Records.Count</span></h2></div><div class="ioc-head-actions"><a class="button button-secondary" asp-page-handler="Csv" asp-route-days="@Model.Days" asp-route-vendor="@Model.Vendor" asp-route-industry="@Model.Industry" asp-route-type="@Model.Type" asp-route-search="@Model.Search" asp-route-state="@Model.State" asp-route-approval="@Model.Approval">DOWNLOAD CSV ↓</a><a class="button button-secondary" asp-page="/Iocs" asp-route-days="@Model.Days" asp-route-state="@(Model.State == "archived" ? "active" : "archived")">@(Model.State == "archived" ? "ACTIVE INDICATORS" : "ARCHIVE")</a></div></div>
 <form method="get" class="ioc-filters" id="ioc-filter-form"><input type="hidden" name="state" value="@Model.State"/><label>Time range<select name="days"><option value="7" selected="@(Model.Days == 7)">Last 7 days</option><option value="14" selected="@(Model.Days == 14)">Last 14 days</option><option value="30" selected="@(Model.Days == 30)">Last 30 days</option><option value="90" selected="@(Model.Days == 90)">Last 90 days</option><option value="365" selected="@(Model.Days == 365)">Last year</option></select></label><label>Type<select name="type"><option value="">All types</option>@foreach (var value in Model.Types) { <option value="@value" selected="@(Model.Type == value)">@value</option> }</select></label><label>Vendor<select name="vendor"><option value="">All vendors</option>@foreach (var value in Model.Vendors) { <option value="@value" selected="@(Model.Vendor == value)">@value</option> }</select></label><label>Industry<select name="industry"><option value="">All industries</option>@foreach (var value in Model.Industries) { <option value="@value" title="@value" selected="@(Model.Industry == value)">@Model.IndustryLabel(value)</option> }</select></label><label>Approval<select name="approval"><option value="all" selected="@(Model.Approval == "all")">All indicators</option><option value="pending" selected="@(Model.Approval == "pending")">Needs approval</option><option value="approved" selected="@(Model.Approval == "approved")">Approved only</option></select></label><label class="ioc-search">Search<input name="search" value="@Model.Search" placeholder="Value, context, article…"/></label><label class="ioc-api-toggle"><input type="checkbox" name="includeUnapproved" value="true" checked="@(Model.IncludeUnapproved)"/><span>Include unapproved in API example</span></label><span class="ioc-auto-apply"><i></i> AUTO APPLY</span></form>
 @if (Model.Records.Count == 0) { <div class="empty-state"><div class="empty-icon">⌁</div><h3>No indicators match</h3><p>Try a wider time range or clear one of the filters.</p></div> }
 <div class="ioc-list">
 @foreach (var ioc in Model.Records) {
  <article class="ioc-row"><div class="ioc-type">@ioc.Type</div><div class="ioc-main"><h3><code>@ioc.Value</code>@if (!string.IsNullOrWhiteSpace(ioc.NormalizedValue) && ioc.NormalizedValue != ioc.Value) { <small>Normalized: <code>@ioc.NormalizedValue</code></small> }</h3><p>@ioc.Context</p><div class="ioc-tags">@if (!string.IsNullOrWhiteSpace(ioc.Role)) { <span>@ioc.Role</span> }@foreach (var vendor in ioc.Vendors) { <span>Vendor · @vendor</span> }@foreach (var industry in ioc.Industries) { <span>Industry · @industry</span> }@foreach (var mitre in ioc.Mitre) { <span>MITRE · @mitre</span> }</div><div class="ioc-links"><a class="small-action ioc-article-link" href="@ioc.ArticleUrl" target="_blank" rel="noopener noreferrer">@ioc.ArticleTitle ↗</a>@if (Model.VirusTotalUrl(ioc) is string vtUrl) { <a class="small-action" href="@vtUrl" target="_blank" rel="noopener noreferrer">OPEN IN VIRUSTOTAL ↗</a> }</div></div><div class="ioc-confidence"><span class="ioc-approval @(ioc.Approved ? "approved" : "pending")">@(ioc.Approved ? "APPROVED" : "NEEDS APPROVAL")</span>@if (ioc.ExpiresUtc is DateTimeOffset expiry) { <small title="Expires @expiry.ToLocalTime().ToString("dd MMM yyyy")">Active until @expiry.ToLocalTime().ToString("dd MMM yyyy")</small> } else { <small>No automatic expiry</small> }<small>@(DateTimeOffset.TryParse(ioc.ArticleDate, out var published) ? published.ToLocalTime().ToString("dd MMM yyyy") : "Date unknown")</small>@if (Model.State == "archived") { <form method="post" asp-page-handler="Restore"><input type="hidden" name="articleId" value="@ioc.ArticleId"/><input type="hidden" name="iocType" value="@ioc.Type"/><input type="hidden" name="iocValue" value="@ioc.Value"/><input type="hidden" name="days" value="@Model.Days"/><input type="hidden" name="vendor" value="@Model.Vendor"/><input type="hidden" name="industry" value="@Model.Industry"/><input type="hidden" name="type" value="@Model.Type"/><input type="hidden" name="search" value="@Model.Search"/><input type="hidden" name="state" value="@Model.State"/><input type="hidden" name="approval" value="@Model.Approval"/><button class="small-action" type="submit">RESTORE</button></form> } else { <div class="ioc-row-actions">@if (!ioc.Approved) { <form method="post" asp-page-handler="Approve"><input type="hidden" name="articleId" value="@ioc.ArticleId"/><input type="hidden" name="iocType" value="@ioc.Type"/><input type="hidden" name="iocValue" value="@ioc.Value"/><input type="hidden" name="days" value="@Model.Days"/><input type="hidden" name="vendor" value="@Model.Vendor"/><input type="hidden" name="industry" value="@Model.Industry"/><input type="hidden" name="type" value="@Model.Type"/><input type="hidden" name="search" value="@Model.Search"/><input type="hidden" name="state" value="@Model.State"/><input type="hidden" name="approval" value="@Model.Approval"/><input type="hidden" name="includeUnapproved" value="@Model.IncludeUnapproved"/><button class="small-action approve-ioc" type="submit">APPROVE</button></form> }<form method="post" asp-page-handler="Dismiss"><input type="hidden" name="articleId" value="@ioc.ArticleId"/><input type="hidden" name="iocType" value="@ioc.Type"/><input type="hidden" name="iocValue" value="@ioc.Value"/><input type="hidden" name="days" value="@Model.Days"/><input type="hidden" name="vendor" value="@Model.Vendor"/><input type="hidden" name="industry" value="@Model.Industry"/><input type="hidden" name="type" value="@Model.Type"/><input type="hidden" name="search" value="@Model.Search"/><input type="hidden" name="state" value="@Model.State"/><input type="hidden" name="approval" value="@Model.Approval"/><input type="hidden" name="includeUnapproved" value="@Model.IncludeUnapproved"/><button class="small-action" type="submit">DISMISS</button></form></div> }</div></article>
 }
 </div>
 <div class="list-foot">@if (Model.State == "archived") { <span>Archived indicators are excluded from the read-only API.</span> } else { <><span>API: <code>GET @Model.ApiExampleUrl</code></span><span>Only approved indicators are returned by default; set <code>includeUnapproved=true</code> to include pending ones.</span></> }</div>
</section>
@if (Model.State != "archived") { <section class="panel api-panel"><div class="eyebrow">READ ONLY JSON API</div><h2>Matching indicators</h2><p>This request uses the current filters. Change any filter to update the example.</p><pre><code>GET @Model.ApiExampleUrl</code></pre></section> }
<script>
(() => {
  const form = document.querySelector('#ioc-filter-form');
  if (!form) return;
  for (const control of form.querySelectorAll('select,input[type="checkbox"]')) control.addEventListener('change', () => form.requestSubmit());
  const search = form.querySelector('input[name="search"]');
  let debounce;
  search?.addEventListener('input', () => {
    clearTimeout(debounce);
    debounce = setTimeout(() => form.requestSubmit(), 400);
  });
})();
</script>
