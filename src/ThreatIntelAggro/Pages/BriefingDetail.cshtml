@page "/briefings/{id:long}"
@model BriefingDetailModel
@{
  ViewData["Title"] = "Briefing Archive";
}
<div class="page-heading"><div><div class="eyebrow">ARCHIVED BRIEFING</div><h1>@Model.Item!["title"]</h1><p class="subhead">@Model.Item["window_start_utc"] – @Model.Item["window_end_utc"] UTC</p></div><a class="button button-secondary" asp-page="/Index">← BRIEFINGS</a></div>
<section class="panel briefing-panel"><section class="briefing-section"><div class="eyebrow">EXECUTIVE BRIEFING</div><p>@Model.Item["executive_summary"]</p></section><section class="briefing-section"><div class="eyebrow">APPLICABLE ARTICLES</div><ul class="briefing-articles">@foreach (var a in Model.Articles) { <li><a href="@a.GetProperty("Url").GetString()" target="_blank" rel="noopener noreferrer">@a.GetProperty("Title").GetString() ↗</a><small>Vendors: @a.GetProperty("VendorMatches").GetString() · Industries: @a.GetProperty("IndustryMatches").GetString()@if (BriefingView.ProductMatches(a) is string products && products.Length > 0) { <text> · Products: @products</text> }</small>@if (!string.IsNullOrWhiteSpace(BriefingView.MatchReasons(a))) { <small>Match basis: @BriefingView.MatchReasons(a)</small> }</li> }</ul></section><section class="briefing-section"><div class="eyebrow">DETECTION SUMMARY</div><p>@Model.Item["detection_summary"]</p></section><section class="briefing-section"><div class="eyebrow">IOC SUMMARY</div><p>@Model.Item["ioc_summary"]</p></section></section>
