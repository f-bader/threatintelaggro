@page
@model IndexModel
@{
  ViewData["Title"] = "Briefings";
}
<div class="page-heading"><div><div class="eyebrow"><span class="live-dot"></span> DAILY THREAT INTELLIGENCE / UTC</div><h1>Threat briefings</h1><p class="subhead">Decision-ready coverage for the vendors and industries you follow.</p></div><a class="button button-secondary" asp-page="/Settings">BRIEFING SETTINGS</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="notice">@Model.Notice</div> }
@if (Model.Latest is null) {
  <section class="panel briefing-empty"><div class="eyebrow">NO BRIEFING ARCHIVED</div><h2>Follow vendors or industries to start your briefing stream.</h2><p>Daily generation runs at the configured UTC time. A briefing is created only when applicable analyzed articles are available.</p><a class="button button-primary" asp-page="/Settings">CONFIGURE BRIEFING</a></section>
} else {
  <section class="panel briefing-panel"><div class="briefing-topline"><div><div class="eyebrow">LATEST DAILY BRIEFING</div><h2>@Model.Latest["title"]</h2><p class="subhead">@DateTimeOffset.Parse(Model.Latest["window_start_utc"]!).ToString("dd MMM yyyy HH:mm") – @DateTimeOffset.Parse(Model.Latest["window_end_utc"]!).ToString("dd MMM yyyy HH:mm") UTC</p></div><div class="briefing-actions"><a class="button button-secondary" href="/?handler=Markdown&amp;id=@Model.Latest["id"]">DOWNLOAD MARKDOWN</a><a class="button button-secondary" href="/?handler=Pdf&amp;id=@Model.Latest["id"]">DOWNLOAD PDF</a></div></div>
  <section class="briefing-section"><div class="eyebrow">EXECUTIVE BRIEFING</div><p>@Model.Latest["executive_summary"]</p></section>
  <section class="briefing-section"><div class="eyebrow">APPLICABLE ARTICLES · @Model.Articles.Length</div><ul class="briefing-articles">@foreach (var a in Model.Articles) { <li><a href="@a.GetProperty("Url").GetString()" target="_blank" rel="noopener noreferrer">@a.GetProperty("Title").GetString() ↗</a><span>@a.GetProperty("PublishedUtc").GetString()</span><small>@if (a.GetProperty("VendorMatches").GetString() is string v && v.Length > 0) { <text>Vendors: @v</text> } @if (a.GetProperty("IndustryMatches").GetString() is string i && i.Length > 0) { <text> · Industries: @i</text> }</small>@if (!string.IsNullOrWhiteSpace(BriefingView.MatchReasons(a))) { <small>Match basis: @BriefingView.MatchReasons(a)</small> }</li> }</ul></section>
  <div class="briefing-summary-grid"><section class="briefing-section"><div class="eyebrow">DETECTION SUMMARY</div><p>@Model.Latest["detection_summary"]</p></section><section class="briefing-section"><div class="eyebrow">IOC SUMMARY</div><p>@Model.Latest["ioc_summary"]</p></section></div></section>
}
<section class="panel briefing-archive"><div class="panel-head"><div><div class="eyebrow">HISTORICAL SNAPSHOTS</div><h2>Briefing archive <span class="count-chip">@Model.Archive.Count</span></h2></div><form method="post" asp-page-handler="Generate"><button class="button button-primary" type="submit">GENERATE NOW</button></form></div>
@if (Model.Archive.Count == 0) { <p class="form-footnote">Briefings will be archived here as they are generated.</p> } else { <div class="briefing-archive-list">@foreach (var item in Model.Archive) { <article><div><a href="/briefings/@item["id"]">@item["title"]</a><small>@DateTimeOffset.Parse(item["window_start_utc"]!).ToString("dd MMM HH:mm") – @DateTimeOffset.Parse(item["window_end_utc"]!).ToString("dd MMM HH:mm") UTC</small></div><div class="briefing-actions"><a class="small-action" href="/?handler=Markdown&amp;id=@item["id"]">MD</a><a class="small-action" href="/?handler=Pdf&amp;id=@item["id"]">PDF</a></div></article> }</div> }</section>
