@page
@model FeedsModel
@{
    ViewData["Title"] = "Feeds";
}
<div class="page-heading"><div><div class="eyebrow">COLLECTION / SOURCES</div><h1>Feed manager</h1><p class="subhead">Keep your threat intelligence sources in one place.</p></div><a class="button button-secondary" asp-page="/Index">← &nbsp;Back to inbox</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="notice">@Model.Notice</div> }
<section class="panel feed-panel"><div class="panel-head"><div><div class="eyebrow">MONITORED SOURCES</div><h2>Your feeds <span class="count-chip">@Model.TotalFeedCount</span></h2></div><div class="feed-tools"><span class="feed-result-count">@Model.Feeds.Count shown</span><span class="sync-indicator"><i></i> Scheduler active</span></div></div>
<form method="get" class="feed-filter-form" aria-label="Filter feeds">
 <div class="feed-filter-heading"><span>ADVANCED FILTERS</span><span>Always visible · @Model.Feeds.Count of @Model.TotalFeedCount feeds</span></div>
 <div class="feed-filter-grid">
  <label class="feed-search">Search feeds<input type="search" name="search" value="@Model.Search" placeholder="Name or feed URL" aria-label="Search feed name or URL"/></label>
  <label>Status<select name="status"><option value="all" selected="@(Model.Status == "all")">All feeds</option><option value="unreachable" selected="@(Model.Status == "unreachable")">Not reachable</option><option value="active" selected="@(Model.Status == "active")">Active</option><option value="paused" selected="@(Model.Status == "paused")">Paused</option></select></label>
  <label>Cadence<select name="cadence"><option value="all" selected="@(Model.Cadence == "all")">Any cadence</option><option value="3" selected="@(Model.Cadence == "3")">Every 3 hours</option><option value="6" selected="@(Model.Cadence == "6")">Every 6 hours</option><option value="12" selected="@(Model.Cadence == "12")">Every 12 hours</option><option value="24" selected="@(Model.Cadence == "24")">Every 24 hours</option></select></label>
  <label>IOC pre-approval<select name="iocApproval"><option value="all" selected="@(Model.IocApproval == "all")">Any setting</option><option value="enabled" selected="@(Model.IocApproval == "enabled")">Enabled</option><option value="disabled" selected="@(Model.IocApproval == "disabled")">Disabled</option></select></label>
  <div class="feed-filter-actions"><button class="button button-secondary" type="submit">Apply filters</button><a class="button button-quiet" asp-page="/Feeds">Clear</a></div>
 </div>
</form>
<div class="feed-table-wrap"><table class="feed-table"><thead><tr>
<th aria-sort="@(Model.Sort == "name" ? (Model.Direction == "asc" ? "ascending" : "descending") : "none")"><a asp-page="/Feeds" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-cadence="@Model.Cadence" asp-route-iocApproval="@Model.IocApproval" asp-route-sort="name" asp-route-direction="@Model.NextDirection("name")">FEED <span aria-hidden="true">@Model.SortIndicator("name")</span></a></th>
<th aria-sort="@(Model.Sort == "cadence" ? (Model.Direction == "asc" ? "ascending" : "descending") : "none")"><a asp-page="/Feeds" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-cadence="@Model.Cadence" asp-route-iocApproval="@Model.IocApproval" asp-route-sort="cadence" asp-route-direction="@Model.NextDirection("cadence")">CADENCE <span aria-hidden="true">@Model.SortIndicator("cadence")</span></a></th>
<th aria-sort="@(Model.Sort == "articles" ? (Model.Direction == "asc" ? "ascending" : "descending") : "none")"><a asp-page="/Feeds" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-cadence="@Model.Cadence" asp-route-iocApproval="@Model.IocApproval" asp-route-sort="articles" asp-route-direction="@Model.NextDirection("articles")">ARTICLES <span aria-hidden="true">@Model.SortIndicator("articles")</span></a></th>
<th aria-sort="@(Model.Sort == "checked" ? (Model.Direction == "asc" ? "ascending" : "descending") : "none")"><a asp-page="/Feeds" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-cadence="@Model.Cadence" asp-route-iocApproval="@Model.IocApproval" asp-route-sort="checked" asp-route-direction="@Model.NextDirection("checked")">LAST CHECKED <span aria-hidden="true">@Model.SortIndicator("checked")</span></a></th>
<th aria-sort="@(Model.Sort == "status" ? (Model.Direction == "asc" ? "ascending" : "descending") : "none")"><a asp-page="/Feeds" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-cadence="@Model.Cadence" asp-route-iocApproval="@Model.IocApproval" asp-route-sort="status" asp-route-direction="@Model.NextDirection("status")">STATUS <span aria-hidden="true">@Model.SortIndicator("status")</span></a></th><th></th></tr></thead><tbody>
@foreach (var feed in Model.Feeds)
{
 <tr><td><div class="feed-name"><span class="source-initial">@((feed["title"] ?? "?").FirstOrDefault())</span><div><strong>@feed["title"]</strong><small>@(feed["source_type"] == "github" ? "GITHUB REPOSITORY · " : "RSS / ATOM · ")@feed["url"]</small>@if (feed["ioc_auto_approve"] == "1") { <span class="status-pill ioc-preapproved">IOC PRE-APPROVED</span> }</div></div><details class="edit-feed @(feed["source_type"] == "github" ? "github-source" : "")"><summary>Edit</summary><form method="post" asp-page-handler="Edit"><input type="hidden" name="id" value="@feed["id"]"/>@await Html.PartialAsync("_FeedViewState", Model)<input name="title" value="@feed["title"]" maxlength="100" required aria-label="Feed name"/><input type="url" name="feedUrl" value="@feed["url"]" required aria-label="@(feed["source_type"] == "github" ? "GitHub repository URL" : "Feed URL")"/><select name="intervalHours" aria-label="Refresh interval"><option value="3" selected="@(feed["interval_hours"] == "3")">3h</option><option value="6" selected="@(feed["interval_hours"] == "6")">6h</option><option value="12" selected="@(feed["interval_hours"] == "12")">12h</option><option value="24" selected="@(feed["interval_hours"] == "24")">24h</option></select><label class="feed-auto-approve"><input type="checkbox" name="iocAutoApprove" value="true" checked="@(feed["ioc_auto_approve"] == "1")"/><span>IOC pre approved</span></label><button class="small-action" type="submit">Save</button></form></details></td><td>Every @feed["interval_hours"] hours</td><td>@feed["article_count"]</td><td>@(DateTimeOffset.TryParse(feed["last_checked_utc"], out var checkedAt) ? checkedAt.ToLocalTime().ToString("dd MMM · HH:mm") : "Waiting for first poll")</td><td>@if (!string.IsNullOrWhiteSpace(feed["last_error"])) { <span class="status-pill status-error" title="@feed["last_error"]" aria-label="Not reachable: @feed["last_error"]">Not reachable</span> } else { <span class="status-pill @(feed["enabled"] == "1" ? "status-on" : "status-off")">@(feed["enabled"] == "1" ? "Active" : "Paused")</span> }</td><td><div class="feed-actions"><form method="post" asp-page-handler="Refresh"><input type="hidden" name="id" value="@feed["id"]"/>@await Html.PartialAsync("_FeedViewState", Model)<button class="icon-button" title="Refresh now" aria-label="Refresh @feed["title"] now">⟳</button></form><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@feed["id"]"/>@await Html.PartialAsync("_FeedViewState", Model)<button class="small-action" type="submit">@(feed["enabled"] == "1" ? "Pause" : "Resume")</button></form><form method="post" asp-page-handler="Remove" data-confirm="Remove this feed? Previously collected articles will remain."><input type="hidden" name="id" value="@feed["id"]"/>@await Html.PartialAsync("_FeedViewState", Model)<button class="small-action danger-action" type="submit">Remove</button></form></div></td></tr>
}
@if (Model.Feeds.Count == 0) { <tr><td class="feed-empty" colspan="6">No feeds match this filter.</td></tr> }
</tbody></table></div></section>
<section class="panel add-feed-panel"><div class="panel-head"><div><div class="eyebrow">EXPAND YOUR COVERAGE</div><h2>Add a feed</h2></div><span class="quiet-label">RSS or Atom</span></div>
<form method="post" asp-page-handler="Add" class="add-feed-form"><div asp-validation-summary="ModelOnly" class="validation"></div>@await Html.PartialAsync("_FeedViewState", Model)<label>Feed name<input asp-for="Title" placeholder="e.g. Security research blog" required maxlength="100"/></label><label>Feed URL<input asp-for="FeedUrl" type="url" placeholder="https://example.com/feed/" required/></label><label>Check every<select asp-for="IntervalHours"><option value="3">3 hours</option><option value="6">6 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select></label><label class="feed-auto-approve add-feed-auto-approve"><input asp-for="IocAutoApprove" type="checkbox"/><span>IOC pre approved</span></label><button class="button button-primary" type="submit">Add feed <span>＋</span></button></form><p class="form-footnote">New feeds load entries published in the last 14 days, as the source makes available. Feed checks run automatically. Enabling IOC pre-approval also approves indicators from completed, evidence-validated analyses of that feed. Older analyses require manual review. Turning the option off does not revoke prior approvals.</p></section>
<section class="panel add-feed-panel"><div class="panel-head"><div><div class="eyebrow">GITHUB SECURITY</div><h2>Monitor a repository</h2></div><span class="quiet-label">PUBLIC, PUBLISHED ADVISORIES</span></div>
<form method="post" asp-page-handler="AddGitHubRepository" class="add-feed-form github-source-form">@await Html.PartialAsync("_FeedViewState", Model)<label>GitHub repository URL<input asp-for="GitHubRepositoryUrl" type="url" placeholder="https://github.com/owner/repository" required/></label><label>Check every<select asp-for="IntervalHours"><option value="3">3 hours</option><option value="6">6 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select></label><button class="button button-primary" type="submit">Add repository <span>＋</span></button></form><p class="form-footnote">Published advisories from the last 14 days appear in your inbox. Polling uses GitHub's public API and does not require a token. Draft and unpublished advisories are not collected.</p></section>
<section class="panel add-feed-panel opml-panel"><div class="panel-head"><div><div class="eyebrow">BULK SOURCE SETUP</div><h2>Import OPML</h2></div><span class="quiet-label">OPML 2.0 · MAX 2 MB</span></div>
<form method="post" asp-page-handler="ImportOpml" enctype="multipart/form-data" class="opml-form">@await Html.PartialAsync("_FeedViewState", Model)<label for="OpmlFile">Choose an OPML file</label><input asp-for="OpmlFile" id="OpmlFile" type="file" accept=".opml,.xml,text/xml,application/xml"/><details><summary>Or paste OPML text</summary><textarea asp-for="OpmlText" id="OpmlText" rows="6" placeholder="Paste an OPML export here"></textarea></details><div class="opml-footer"><span>Existing feed URLs are skipped. Imported feeds use the default 6 hour interval. Max file size 2 MB.</span><button class="button button-secondary" type="submit">IMPORT FEEDS ↥</button></div></form></section>
