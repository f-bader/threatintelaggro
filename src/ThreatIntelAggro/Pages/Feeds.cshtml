@page
@model FeedsModel
@{
    ViewData["Title"] = "Feeds";
}
<div class="page-heading"><div><div class="eyebrow">COLLECTION / SOURCES</div><h1>Feed manager</h1><p class="subhead">Keep your threat intelligence sources in one place.</p></div><a class="button button-secondary" asp-page="/Index">← &nbsp;Back to inbox</a></div>
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <div class="notice">@Model.Notice</div> }
<section class="panel feed-panel"><div class="panel-head"><div><div class="eyebrow">MONITORED SOURCES</div><h2>Your feeds <span class="count-chip">@Model.Feeds.Count</span></h2></div><div class="feed-tools"><form method="get" class="toolbar"><select asp-for="Status" aria-label="Filter feeds" onchange="this.form.submit()"><option value="all">All feeds</option><option value="unreachable">Not reachable</option><option value="active">Active</option><option value="paused">Paused</option></select></form><span class="sync-indicator"><i></i> Scheduler active</span></div></div>
<div class="feed-table-wrap"><table class="feed-table"><thead><tr><th>FEED</th><th>CADENCE</th><th>ARTICLES</th><th>LAST CHECKED</th><th>STATUS</th><th></th></tr></thead><tbody>
@foreach (var feed in Model.Feeds)
{
 <tr><td><div class="feed-name"><span class="source-initial">@((feed["title"] ?? "?").FirstOrDefault())</span><div><strong>@feed["title"]</strong><small>@feed["url"]</small>@if (feed["ioc_auto_approve"] == "1") { <span class="status-pill ioc-preapproved">IOC PRE-APPROVED</span> }</div></div><details class="edit-feed"><summary>Edit</summary><form method="post" asp-page-handler="Edit"><input type="hidden" name="id" value="@feed["id"]"/><input name="title" value="@feed["title"]" maxlength="100" required aria-label="Feed name"/><input type="url" name="feedUrl" value="@feed["url"]" required aria-label="Feed URL"/><select name="intervalHours" aria-label="Refresh interval"><option value="3" selected="@(feed["interval_hours"] == "3")">3h</option><option value="6" selected="@(feed["interval_hours"] == "6")">6h</option><option value="12" selected="@(feed["interval_hours"] == "12")">12h</option><option value="24" selected="@(feed["interval_hours"] == "24")">24h</option></select><label class="feed-auto-approve"><input type="checkbox" name="iocAutoApprove" value="true" checked="@(feed["ioc_auto_approve"] == "1")"/><span>IOC pre approved</span></label><button class="small-action" type="submit">Save</button></form></details></td><td>Every @feed["interval_hours"] hours</td><td>@feed["article_count"]</td><td>@(DateTimeOffset.TryParse(feed["last_checked_utc"], out var checkedAt) ? checkedAt.ToLocalTime().ToString("dd MMM · HH:mm") : "Waiting for first poll")</td><td>@if (!string.IsNullOrWhiteSpace(feed["last_error"])) { <span class="status-pill status-error" title="@feed["last_error"]" aria-label="Not reachable: @feed["last_error"]">Not reachable</span> } else { <span class="status-pill @(feed["enabled"] == "1" ? "status-on" : "status-off")">@(feed["enabled"] == "1" ? "Active" : "Paused")</span> }</td><td><div class="feed-actions"><form method="post" asp-page-handler="Refresh"><input type="hidden" name="id" value="@feed["id"]"/><button class="icon-button" title="Refresh now" aria-label="Refresh @feed["title"] now">⟳</button></form><form method="post" asp-page-handler="Toggle"><input type="hidden" name="id" value="@feed["id"]"/><button class="small-action" type="submit">@(feed["enabled"] == "1" ? "Pause" : "Resume")</button></form><form method="post" asp-page-handler="Remove" onsubmit="return confirm('Remove this feed? Previously collected articles will remain.');"><input type="hidden" name="id" value="@feed["id"]"/><button class="small-action danger-action" type="submit">Remove</button></form></div></td></tr>
}
@if (Model.Feeds.Count == 0) { <tr><td class="feed-empty" colspan="6">No feeds match this filter.</td></tr> }
</tbody></table></div></section>
<section class="panel add-feed-panel"><div class="panel-head"><div><div class="eyebrow">EXPAND YOUR COVERAGE</div><h2>Add a feed</h2></div><span class="quiet-label">RSS or Atom</span></div>
<form method="post" asp-page-handler="Add" class="add-feed-form"><div asp-validation-summary="ModelOnly" class="validation"></div><label>Feed name<input asp-for="Title" placeholder="e.g. Security research blog" required maxlength="100"/></label><label>Feed URL<input asp-for="FeedUrl" type="url" placeholder="https://example.com/feed/" required/></label><label>Check every<select asp-for="IntervalHours"><option value="3">3 hours</option><option value="6">6 hours</option><option value="12">12 hours</option><option value="24">24 hours</option></select></label><label class="feed-auto-approve add-feed-auto-approve"><input asp-for="IocAutoApprove" type="checkbox"/><span>IOC pre approved</span></label><button class="button button-primary" type="submit">Add feed <span>＋</span></button></form><p class="form-footnote">New feeds load entries published in the last 14 days, as the source makes available. Feed checks run automatically. Enabling IOC pre-approval also approves indicators from completed, evidence-validated analyses of that feed. Older analyses require manual review. Turning the option off does not revoke prior approvals.</p></section>
<section class="panel add-feed-panel opml-panel"><div class="panel-head"><div><div class="eyebrow">BULK SOURCE SETUP</div><h2>Import OPML</h2></div><span class="quiet-label">OPML 2.0 · MAX 2 MB</span></div>
<form method="post" asp-page-handler="ImportOpml" enctype="multipart/form-data" class="opml-form"><label for="OpmlFile">Choose an OPML file</label><input asp-for="OpmlFile" id="OpmlFile" type="file" accept=".opml,.xml,text/xml,application/xml"/><details><summary>Or paste OPML text</summary><textarea asp-for="OpmlText" id="OpmlText" rows="6" placeholder="Paste an OPML export here"></textarea></details><div class="opml-footer"><span>Existing feed URLs are skipped. Imported feeds use the default 6 hour interval. Max file size 2 MB.</span><button class="button button-secondary" type="submit">IMPORT FEEDS ↥</button></div></form></section>
